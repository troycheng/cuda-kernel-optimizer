{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CUDA Kernel Optimizer driver request v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version", "request_digest", "target_id", "execution_id",
    "operation", "subjects", "test_suite", "correctness", "objective",
    "acquisition", "case", "sampling", "output_path", "driver_identity"
  ],
  "properties": {
    "protocol_version": {"const": "cuda-kernel-optimizer/driver-request-v2"},
    "request_digest": {"$ref": "#/$defs/sha256"},
    "target_id": {"$ref": "#/$defs/text"},
    "execution_id": {"$ref": "#/$defs/text"},
    "operation": {"$ref": "#/$defs/text"},
    "subjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/subject"}
    },
    "test_suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "locator", "case_ids"],
      "properties": {
        "digest": {"$ref": "#/$defs/sha256"},
        "locator": {"$ref": "#/$defs/text"},
        "case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        }
      }
    },
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "method", "acceptance"],
      "properties": {
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["digest", "locator"],
          "properties": {
            "digest": {"$ref": "#/$defs/sha256"},
            "locator": {"$ref": "#/$defs/text"}
          }
        },
        "method": {"$ref": "#/$defs/text"},
        "acceptance": {}
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_metric", "constraints"],
      "properties": {"primary_metric": {}, "constraints": {}}
    },
    "acquisition": {"$ref": "#/$defs/acquisition"},
    "case": {"type": "object"},
    "sampling": {"type": "object"},
    "output_path": {"$ref": "#/$defs/text"},
    "driver_identity": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 4096},
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "digest", "locator"],
      "properties": {
        "kind": {"enum": ["source_snapshot", "artifact", "deployment"]},
        "digest": {"$ref": "#/$defs/sha256"},
        "locator": {"$ref": "#/$defs/text"}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "variant"],
      "properties": {
        "role": {"enum": ["original", "reference", "candidate"]},
        "variant": {"$ref": "#/$defs/variant"}
      }
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycle", "shared_state", "rebuilt_state"],
      "properties": {
        "lifecycle": {"enum": ["isolated_process", "same_process"]},
        "shared_state": {
          "type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}
        },
        "rebuilt_state": {
          "type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}
        }
      }
    }
  }
}
