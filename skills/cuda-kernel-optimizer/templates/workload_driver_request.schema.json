{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CUDA Kernel Optimizer driver request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "request_digest",
    "target_id",
    "execution_id",
    "operation",
    "variant",
    "test_suite",
    "correctness",
    "objective",
    "role",
    "mode",
    "case",
    "sampling",
    "output_path",
    "driver_identity"
  ],
  "properties": {
    "protocol_version": {"const": "cuda-kernel-optimizer/driver-request-v1"},
    "request_digest": {"$ref": "#/$defs/sha256"},
    "target_id": {"$ref": "#/$defs/text"},
    "execution_id": {"$ref": "#/$defs/text"},
    "operation": {"$ref": "#/$defs/text"},
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "digest", "locator"],
      "properties": {
        "kind": {"enum": ["source_snapshot", "artifact", "deployment"]},
        "digest": {"$ref": "#/$defs/sha256"},
        "locator": {"$ref": "#/$defs/text"}
      }
    },
    "test_suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "locator", "case_ids"],
      "properties": {
        "digest": {"$ref": "#/$defs/sha256"},
        "locator": {"$ref": "#/$defs/text"},
        "case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        }
      }
    },
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "method", "acceptance"],
      "properties": {
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["digest", "locator"],
          "properties": {
            "digest": {"$ref": "#/$defs/sha256"},
            "locator": {"$ref": "#/$defs/text"}
          }
        },
        "method": {"$ref": "#/$defs/text"},
        "acceptance": {}
      }
    },
    "objective": {
      "description": "The exact primary and constraint measurement contract that the result must close.",
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_metric", "constraints"],
      "properties": {"primary_metric": {}, "constraints": {}}
    },
    "role": {"enum": ["original", "reference", "candidate"]},
    "mode": {"enum": ["correctness", "measure", "combined"]},
    "case": {"type": "object", "description": "V1 supplies an id; resolve the full case from the frozen test suite."},
    "sampling": {"type": "object", "description": "Open V1 sampling instruction. Readiness uses repetitions; baseline uses samples_per_case."},
    "output_path": {"$ref": "#/$defs/text"},
    "driver_identity": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 4096}
  }
}
