{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CUDA Kernel Optimizer driver result v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version", "request_digest", "target_id", "execution_id",
    "subject_digests", "case_id", "artifacts", "cleanup",
    "driver_identity", "environment", "acquisition", "evidence"
  ],
  "properties": {
    "protocol_version": {"const": "cuda-kernel-optimizer/driver-result-v2"},
    "request_digest": {"$ref": "#/$defs/sha256"},
    "target_id": {"$ref": "#/$defs/text"},
    "execution_id": {"$ref": "#/$defs/text"},
    "subject_digests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/subject_digest"}
    },
    "case_id": {"type": ["string", "null"]},
    "artifacts": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "live_tasks"],
      "properties": {
        "status": {"const": "confirmed"},
        "live_tasks": {"type": "array", "maxItems": 0}
      }
    },
    "driver_identity": {"$ref": "#/$defs/sha256"},
    "environment": {"$ref": "#/$defs/environment"},
    "acquisition": {"$ref": "#/$defs/acquisition"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correctness", "measurements"],
      "properties": {
        "correctness": {
          "type": "array", "minItems": 1, "maxItems": 2,
          "items": {"$ref": "#/$defs/correctness_evidence"}
        },
        "measurements": {
          "type": "array", "minItems": 1, "maxItems": 2,
          "items": {"$ref": "#/$defs/measurement_evidence"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 4096},
    "role": {"enum": ["original", "reference", "candidate"]},
    "finite_number": {"type": "number"},
    "subject_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "digest"],
      "properties": {
        "role": {"$ref": "#/$defs/role"},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycle", "shared_state", "rebuilt_state"],
      "properties": {
        "lifecycle": {"enum": ["isolated_process", "same_process"]},
        "shared_state": {
          "type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}
        },
        "rebuilt_state": {
          "type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "relative_path", "sha256"],
      "properties": {
        "kind": {"type": "string", "minLength": 1, "maxLength": 128},
        "relative_path": {
          "type": "string", "minLength": 1, "maxLength": 4096,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000]+$"
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gpu_uuids", "gpu_models", "gpu_architectures", "driver_version",
        "cuda_runtime_version", "frameworks", "runtime_provenance"
      ],
      "properties": {
        "gpu_uuids": {
          "type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}
        },
        "gpu_models": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "gpu_architectures": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "driver_version": {"$ref": "#/$defs/text"},
        "cuda_runtime_version": {"$ref": "#/$defs/text"},
        "frameworks": {
          "type": "object",
          "propertyNames": {"minLength": 1, "maxLength": 128},
          "additionalProperties": {"$ref": "#/$defs/text"}
        },
        "runtime_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "identity", "lineage_complete", "lineage", "components"],
          "properties": {
            "kind": {"enum": ["host", "container"]},
            "identity": {"$ref": "#/$defs/text"},
            "lineage_complete": {"type": "boolean"},
            "lineage": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "identity"],
                "properties": {
                  "kind": {"enum": ["base", "overlay"]},
                  "identity": {"$ref": "#/$defs/text"}
                }
              }
            },
            "components": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "identity"],
                "properties": {
                  "name": {"$ref": "#/$defs/text"},
                  "identity": {"$ref": "#/$defs/text"}
                }
              }
            }
          }
        }
      }
    },
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "metrics"],
      "properties": {
        "status": {"enum": ["passed", "failed"]},
        "metrics": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/finite_number"}
        }
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "constraints"],
      "properties": {
        "primary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "unit", "samples"],
          "properties": {
            "name": {"$ref": "#/$defs/text"},
            "unit": {"$ref": "#/$defs/text"},
            "samples": {
              "type": "array", "minItems": 1,
              "items": {"$ref": "#/$defs/finite_number"}
            }
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "unit", "samples"],
            "properties": {
              "name": {"$ref": "#/$defs/text"},
              "unit": {"$ref": "#/$defs/text"},
              "samples": {
                "type": "array", "minItems": 1,
                "items": {"$ref": "#/$defs/finite_number"}
              }
            }
          }
        }
      }
    },
    "correctness_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "result"],
      "properties": {
        "role": {"$ref": "#/$defs/role"},
        "result": {"$ref": "#/$defs/correctness"}
      }
    },
    "measurement_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "result"],
      "properties": {
        "role": {"$ref": "#/$defs/role"},
        "result": {"$ref": "#/$defs/measurements"}
      }
    }
  }
}
